{
  "name": "bloompp",
  "version": "2.0.9",
  "description": "Bloom++ — a Void++-style plugin host for chatgpt.com",
  "homepage": "https://github.com/0-V-linuxdo/Bloom#readme",
  "bugs": {
    "url": "https://github.com/0-V-linuxdo/Bloom/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0-V-linuxdo/Bloom.git"
  },
  "license": "GPL-3.0-or-later",
  "author": "0-V-linuxdo & Bloom contributors",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "watch": "node build.mjs --watch",
    "tsc": "tsc --noEmit",
    "lint": "oxlint -c .oxlintrc.json src test",
    "lint:fix": "oxlint -c .oxlintrc.json --fix src test",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "lint:styles:fix": "stylelint \"src/**/*.css\" --fix",
    "test": "bun test",
    "e2e": "node test/e2e/run.mjs",
    "check:update-urls": "node scripts/check-update-urls.mjs"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.0.0",
    "@stylistic/eslint-plugin": "5.9.0",
    "@types/bun": "1.3.10",
    "esbuild": "0.25.9",
    "eslint-plugin-simple-header": "1.2.2",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "oxlint": "1.68.0",
    "playwright-core": "1.55.0",
    "stylelint": "17.4.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
