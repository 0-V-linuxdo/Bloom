{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@api/*": ["src/api/*"],
      "@utils/*": ["src/utils/*"],
      "@host/*": ["src/host/*"],
      "@plugins/*": ["src/plugins/*"]
    }
  },
  "include": ["src"]
}
